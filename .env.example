# PROMESSÔMETRO - PRODUCTION CONFIGURATION

# Supabase (Required for Database & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-DO-NOT-EXPOSE

# AI API Keys
GROQ_API_KEY=your-groq-api-key

# Stripe (Required for Monetization)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Server Config
PORT=3000
NODE_ENV=production
APP_URL=https://www.promessometro.com.br
CORS_ORIGIN=https://www.promessometro.com.br,https://promessometro.com.br

# Rate Limiting & Performance
GLOBAL_RATE_LIMIT=100
MAX_CONCURRENT_POSTS=5
BATCH_DELAY_MS=2000

# Admin
ADMIN_SECRET_KEY=your-secure-admin-key
