{
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/cron/daily-reavaliation",
            "destination": "/api/cron/daily-reavaliation.js"
        },
        {
            "source": "/api/cron/update-stats",
            "destination": "/api/cron/update-stats.js"
        },
        {
            "source": "/api/cron/backup-export",
            "destination": "/api/cron/backup-export.js"
        },
        {
            "source": "/api/cron/process-evidences",
            "destination": "/api/cron/process-evidences.js"
        },
        {
            "source": "/api/cron/politician-ranking",
            "destination": "/api/cron/politician-ranking.js"
        },
        {
            "source": "/api/sitemap.xml",
            "destination": "/api/sitemap.js"
        },
        {
            "source": "/api/sitemap",
            "destination": "/api/sitemap.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/((?!api|_next/static|_next/image|favicon.ico).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily-reavaliation",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/update-stats",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/api/cron/backup-export",
            "schedule": "0 2 * * 0"
        },
        {
            "path": "/api/cron/process-evidences",
            "schedule": "0 8 * * *"
        }
    ],
    "headers": [
        {
            "source": "/politico/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=1800, stale-while-revalidate=3600"
                }
            ]
        },
        {
            "source": "/promessa/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=1800, stale-while-revalidate=3600"
                }
            ]
        }
    ]
}