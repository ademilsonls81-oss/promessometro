{
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/cron/daily-reavaliation",
            "destination": "/api/cron/daily-reavaliation.js"
        },
        {
            "source": "/api/cron/discover-evidences",
            "destination": "/api/cron/discover-evidences.js"
        },
        {
            "source": "/api/cron/pipeline-orchestrator",
            "destination": "/api/cron/pipeline-orchestrator.js"
        },
        {
            "source": "/api/cron/update-stats",
            "destination": "/api/cron/update-stats.js"
        },
        {
            "source": "/api/cron/backup-export",
            "destination": "/api/cron/backup-export.js"
        },
        {
            "source": "/api/cron/process-evidences",
            "destination": "/api/cron/process-evidences.js"
        },
        {
            "source": "/api/cron/politician-ranking",
            "destination": "/api/cron/politician-ranking.js"
        },
        {
            "source": "/api/cron/test-run",
            "destination": "/api/cron/test-run.js"
        },
        {
            "source": "/api/sitemap.xml",
            "destination": "/api/sitemap.js"
        },
        {
            "source": "/api/autonomous-seed",
            "destination": "/api/autonomous-seed.js"
        },
        {
            "source": "/api/sitemap",
            "destination": "/api/sitemap.js"
        },
        {
            "source": "/api/force-reavaliation",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/seed-evaluations",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/sql",
            "destination": "/api/sql.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/((?!api|_next/static|_next/image|favicon.ico).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/pipeline-orchestrator",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/pipeline-orchestrator",
            "schedule": "0 12 * * *"
        },
        {
            "path": "/api/cron/pipeline-orchestrator",
            "schedule": "0 18 * * *"
        },
        {
            "path": "/api/cron/discover-evidences",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/daily-reavaliation",
            "schedule": "0 2 * * *"
        },
        {
            "path": "/api/cron/backup-export",
            "schedule": "0 3 * * 0"
        }
    ],
    "headers": [
        {
            "source": "/politico/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=1800, stale-while-revalidate=3600"
                }
            ]
        },
        {
            "source": "/promessa/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=1800, stale-while-revalidate=3600"
                }
            ]
        }
    ]
}